# ---- LLM(OpenAI 兼容,docs/02 §5)----
LLM_BASE_URL=            # e.g. https://api.deepseek.com/v1 / https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=             # DO NOT commit 真实 key
LLM_MODEL=               # e.g. deepseek-chat / qwen-max
LLM_TIMEOUT=900          # 整次调用上限;长文生成实测 100-500s,别低于 600
LLM_MAX_CONCURRENCY=6    # 所有文本请求共享预算，排队不占请求超时
WORKER_TEXT_CONCURRENCY=2 # 跨计划文本任务并发；同计划脚本有序
LLM_IDLE_TIMEOUT=120     # 流式空闲看门狗:N 秒收不到 chunk 才视为连接挂死
# 脚本事实审稿(docs/07 §3.1):默认开;关掉可省每集一次 LLM 审稿调用
REVIEWER_ENABLED=true
REVIEWER_CHUNK_CHARS=6000 # 单次审稿正文字数上限;长集按段切块并行审,合并 flags

# ---- TTS(docs/03 §3)----
TTS_PROVIDER=edge        # edge(免费) | doubao(火山引擎豆包双向流式,docs/03 §3.5)
TTS_VOICE_EXPERT=zh-CN-YunxiNeural
TTS_VOICE_HOST=zh-CN-XiaoxiaoNeural
TTS_RATE_EXPERT=-5%
TTS_RATE_HOST=+2%
TTS_MAX_CONCURRENCY=1    # 必须为 1，两种 provider 共用进程内单路锁
TTS_FALLBACK_PROVIDER=   # 空=关闭;edge|doubao:主通道鉴权/欠费/重试耗尽时整集改用该通道重合成(不混音色)

# 豆包通道(TTS_PROVIDER=doubao 时生效,seed-tts-2.0 · HTTP 单向流式)
# 新版控制台一个 API Key 即可:控制台→豆包语音→API Key 管理;旧版才需要下面那对
TTS_DOUBAO_API_KEY=
# TTS_DOUBAO_APP_KEY=           # 旧版控制台 App ID + Access Token(与 API_KEY 二选一)
# TTS_DOUBAO_ACCESS_KEY=
TTS_DOUBAO_VOICE_EXPERT=zh_male_m191_uranus_bigtts   # 云舟(男);2.0 音色须配 seed-tts-2.0
TTS_DOUBAO_VOICE_HOST=zh_female_vv_uranus_bigtts     # Vivi(女);换音色看官方《音色列表》
TTS_DOUBAO_RATE_EXPERT=-5        # speech_rate,[-50,100],0 为原速
TTS_DOUBAO_RATE_HOST=2
TTS_DOUBAO_RECV_TIMEOUT=30       # 流式单次读超时,超时按失败退避重试
# TTS_DOUBAO_RESOURCE_ID=seed-tts-2.0   # 用 1.0 音色时改成 seed-tts-1.0

# ---- 音频(docs/03 §4)----
LOUDNESS_I=-16.0
LOUDNESS_TP=-1.5
LOUDNESS_LRA=11.0
FFMPEG_TIMEOUT_SEC=600  # 单次 ffmpeg 调用上限(秒),超时强杀并报错
SILENCE_BETWEEN_CHUNKS_MS=100
AUDIO_ARTIST=DriveCast
AUDIO_COVER_PATH=static/assets/cover.png
QUALITY_MIN_MINUTES=8
QUALITY_MAX_MINUTES=45   # 升级旧安装时检查本机 .env 是否仍覆盖为 22
QUALITY_DURATION_ERROR_PCT=10
QUALITY_MAX_PEAK_DB=-0.5
SPEECH_RATE_HISTORY_WINDOW=20
SPEECH_RATE_MIN_SAMPLES=3

# ---- 内容(docs/01 §2.1)----
TARGET_MINUTES=15        # 10/15/20/30/40
WORDS_PER_MINUTE=300     # 实测 280-320,合成后 ffprobe 回填校准
DEFAULT_EPISODE_COUNT=6

# ---- 认证(用户名+密码登录,JWT)----
# HS256 签名密钥:必配!留空 = 进程级随机,每次重启所有登录全部失效(fail-safe)
# 生成:python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_DAYS=7
# 建户/改密(无注册接口;初始化自动保留锁定的 admin，先 reset-password 解锁):
#   .venv/bin/python -m drivecast reset-password admin   # 交互输入，或环境变量 DRIVECAST_USER_PASSWORD
#   .venv/bin/python -m drivecast create-user alice      # 创建普通用户，密码不要写在命令行
