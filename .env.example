# ---- LLM(OpenAI 兼容,docs/02 §5)----
LLM_BASE_URL=            # e.g. https://api.deepseek.com/v1 / https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=             # DO NOT commit 真实 key
LLM_MODEL=               # e.g. deepseek-chat / qwen-max
LLM_TIMEOUT=300
# 脚本事实审稿(docs/07 §3.1):默认开;关掉可省每集一次 LLM 审稿调用
REVIEWER_ENABLED=true

# ---- TTS(docs/03 §3)----
TTS_VOICE_EXPERT=zh-CN-YunxiNeural
TTS_VOICE_HOST=zh-CN-XiaoxiaoNeural
TTS_RATE_EXPERT=-5%
TTS_RATE_HOST=+2%
TTS_MAX_CONCURRENCY=1    # 上限 3,免费公共服务别打满

# ---- 音频(docs/03 §4)----
LOUDNESS_I=-16.0
LOUDNESS_TP=-1.5
LOUDNESS_LRA=11.0
SILENCE_BETWEEN_CHUNKS_MS=100
AUDIO_ARTIST=DriveCast
AUDIO_COVER_PATH=static/assets/cover.png
QUALITY_MIN_MINUTES=8
QUALITY_MAX_MINUTES=22
QUALITY_DURATION_ERROR_PCT=10
QUALITY_MAX_PEAK_DB=-0.5
SPEECH_RATE_HISTORY_WINDOW=20
SPEECH_RATE_MIN_SAMPLES=3

# ---- 内容(docs/01 §2.1)----
TARGET_MINUTES=15        # 10/15/20
WORDS_PER_MINUTE=300     # 实测 280-320,合成后 ffprobe 回填校准
DEFAULT_EPISODE_COUNT=6
